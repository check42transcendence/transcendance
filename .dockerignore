# Keep local dependencies and generated output out of root-context builds.
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
backend/src/generated/prisma

# Keep local configuration, certificates, and Git history out of images.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
certs
.git

# Exclude local logs and test reports.
**/*.log
**/.DS_Store
**/playwright-report
**/test-results
