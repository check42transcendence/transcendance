generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Defines the allowed Trip membership roles.
enum MemberRole {
  OWNER
  MEMBER

  @@map("member_role")
}

enum ProposalStatus {
  PENDING
  ACCEPTED

  @@map("proposal_status")
}

enum VoteDecision {
  AGREE
  REJECT

  @@map("vote_decision")
}


model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @db.VarChar(254)
  username     String       @db.VarChar(50)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdTrips Trip[]       @relation("TripCreator")
  memberships  TripMember[]
  createdProposals Proposal[]     @relation("ProposalCreator")
  proposalVotes    ProposalVote[]

  @@map("user")
}

model Trip {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String         @db.VarChar(120)
  destination String         @db.VarChar(120)
  description String?        @db.Text
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  creator     User           @relation("TripCreator", fields: [createdBy], references: [id])
  members     TripMember[]
  days        ItineraryDay[]
  proposals   Proposal[]

  @@map("trip")
}

model TripMember {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId   String     @map("trip_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)
  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_member")
}

model ItineraryDay {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  dayNumber Int      @map("day_number")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@unique([tripId, date])
  @@map("itinerary_day")
}


model Proposal {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String         @map("trip_id") @db.Uuid
  title       String         @db.VarChar(160)
  description String?        @db.Text
  status      ProposalStatus @default(PENDING)
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator     User            @relation("ProposalCreator", fields: [createdBy], references: [id])
  votes       ProposalVote[]

  @@index([tripId])
  @@map("proposal")
}


model ProposalVote {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId String       @map("proposal_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  decision   VoteDecision
  votedAt    DateTime     @default(now()) @map("voted_at") @db.Timestamptz(6)

  proposal   Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
  @@index([userId])
  @@map("proposal_vote")
}

